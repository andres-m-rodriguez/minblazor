<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>minblazor</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>minblazor</ToolCommandName>
    <PackageId>MinBlazor</PackageId>
    <Version>0.4.0</Version>
    <Authors>andresitomanuel</Authors>
    <Description>Run a single .razor file as a Blazor WebAssembly app.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinBlazor.Core\MinBlazor.Core.csproj" />
    <ProjectReference Include="..\MinBlazor.Diff\MinBlazor.Diff.csproj" />
    <ProjectReference Include="..\MinBlazor.Parser\MinBlazor.Parser.csproj" />
    <ProjectReference Include="..\MinBlazor.Compiler\MinBlazor.Compiler.csproj" />
    <ProjectReference Include="..\MinBlazor.Build\MinBlazor.Build.csproj" />
    <ProjectReference Include="..\MinBlazor.Index\MinBlazor.Index.csproj" />
    <ProjectReference Include="..\MinBlazor.Scaffold\MinBlazor.Scaffold.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.Build" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>

