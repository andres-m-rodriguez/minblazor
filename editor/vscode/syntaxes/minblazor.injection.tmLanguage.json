{
  "scopeName": "source.minblazor.injection",
  "injectionSelector": "L:text.aspnetcorerazor",
  "patterns": [
    {
      "comment": "@hostTag minblazor dialect — hoist element into <head>",
      "match": "(@)(hostTag)\\b",
      "captures": {
        "1": { "name": "punctuation.definition.keyword.razor" },
        "2": { "name": "keyword.control.flow.razor" }
      }
    }
  ]
}
