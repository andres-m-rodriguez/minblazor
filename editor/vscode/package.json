{
  "name": "minblazor-lsp",
  "displayName": "minblazor",
  "description": "Component IntelliSense for minblazor .razor files",
  "version": "0.1.3",
  "publisher": "minblazor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andres-m-rodriguez/minblazor"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:razor",
    "onLanguage:aspnetcorerazor",
    "workspaceContains:**/*.razor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.minblazor.injection",
        "path": "./syntaxes/minblazor.injection.tmLanguage.json",
        "injectTo": ["text.html.cshtml"]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.82.0",
    "typescript": "^5.4.0"
  }
}
